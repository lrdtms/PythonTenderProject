# Single origin (ADR-0009): /api/* -> FastAPI, everything else -> Next.js.
# The Cloudflare Tunnel points at this container (http://caddy:80).
:80 {
	encode zstd gzip

	handle /api/* {
		request_body {
			max_size 30MB
		}
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy web:3000
	}
}
