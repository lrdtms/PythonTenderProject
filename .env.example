# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
SECRET_KEY=change-me
# Session cookie Secure flag. false only for local plain-http development; it MUST be true
# whenever the site is served over HTTPS, including through the Cloudflare tunnel.
COOKIE_SECURE=false
# Header that carries the real client IP for rate limiting, set by a trusted proxy. Set it to
# CF-Connecting-IP when served through the Cloudflare tunnel. Leave it unset when uvicorn is
# reached directly: the socket peer address is used and X-Forwarded-For is never trusted.
# CLIENT_IP_HEADER=CF-Connecting-IP

POSTGRES_USER=intel
POSTGRES_PASSWORD=intel
POSTGRES_DB=inteltps
# Host port for Postgres. Change it if you already run Postgres locally on 5432.
DB_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://intel:intel@db:5432/inteltps

# Ollama runs natively on the host; containers reach it through host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b
LLM_ALLOW_HOSTED=false

STORAGE_PATH=/data/files
