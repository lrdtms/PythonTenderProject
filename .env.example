# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=development
SECRET_KEY=change-me
# Session cookie Secure flag. false only for local plain-http development (http://127.0.0.1:8080).
# Production and the Cloudflare tunnel (HTTPS) must use ENVIRONMENT=production and
# COOKIE_SECURE=true; the API refuses to start with COOKIE_SECURE=false outside development.
COOKIE_SECURE=false
# Header that carries the real client IP for rate limiting. In Compose the API is reachable only
# through Caddy (its port 8000 is not published), and Caddy always overwrites X-Client-IP with
# CF-Connecting-IP (through the tunnel) or the TCP peer, so a client cannot forge it. An invalid
# or missing value falls back to the socket peer; X-Forwarded-For is never trusted.
# Unset it only if you run uvicorn directly without Caddy (backend/.env), so clients cannot
# pick their own rate-limit bucket.
CLIENT_IP_HEADER=X-Client-IP

POSTGRES_USER=intel
POSTGRES_PASSWORD=intel
POSTGRES_DB=inteltps
# Host port for Postgres. Change it if you already run Postgres locally on 5432.
DB_HOST_PORT=5432
DATABASE_URL=postgresql+psycopg://intel:intel@db:5432/inteltps

# Ollama runs natively on the host; containers reach it through host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3:4b
LLM_ALLOW_HOSTED=false

STORAGE_PATH=/data/files
