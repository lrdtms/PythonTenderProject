# Only for `npm run dev` without Docker: copy this file to .env.development.local (never loaded by
# `next build`, so it cannot leak into a production image). It proxies /api/* to the local API
# (same origin, so the /api-scoped session cookie works). Also set COOKIE_SECURE=false in the
# backend env.
API_PROXY_TARGET=http://127.0.0.1:8000
